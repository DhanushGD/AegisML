__pycache__/
venv/

# ==========================================
# MLOps Data Rules: Ignore large data but track DVC files
# ==========================================

# 1. Ignore actual CSV files anywhere inside the data tree
data/**/*.csv

# 2. Ignore any untracked raw data files 
data/raw/*

# 3. Explicitly allow Git to track all .dvc pointer files
!data/**/*.dvc